FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         5000;

deltaT          1;

writeControl    timeStep;

writeInterval   1;

purgeWrite      1;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    outletFlowRate
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);

        writeControl    timeStep;
        writeInterval   1;

        writeFields     false;

        regionType      patch;
        name            outlet;

        operation       sum;
        fields          (phi);
    }

	stopOnUxResidual
    {
        type            runTimeControl;
        libs            ("libutilityFunctionObjects.so");

        conditions
        {
            UxConverged
            {
                type            equationInitialResidual;
                fields          (U.component(0));
                value           1e-5;
                mode            minimum;
            }
        }

        satisfiedAction end;
    }

    Co1
    {
        // Mandatory entries (unmodifiable)
        type            CourantNo;
        libs            (fieldFunctionObjects);

        // Optional entries (runtime modifiable)
        rho             rho;

        // Optional (inherited) entries
        field           phi;
        enabled         true;
        log             true;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
    }

    	fieldMaxCo
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);

        log             true;
        enabled         true;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;

        regionType      all;
        operation       max;

        fields          (Co);
    }
}

